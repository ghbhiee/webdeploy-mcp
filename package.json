{
  "name": "webdeploy-mcp",
  "version": "0.1.12",
  "private": true,
  "description": "A self-hosted website deployment platform with a web dashboard and MCP interface.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @webdeploy/core build && pnpm --filter @webdeploy/control-plane build && pnpm --filter @webdeploy/worker build && pnpm --filter @webdeploy/cli build && pnpm --filter @webdeploy/dashboard build",
    "dev": "pnpm --parallel --filter @webdeploy/control-plane --filter @webdeploy/dashboard dev",
    "typecheck": "pnpm --filter @webdeploy/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "migrate": "pnpm --filter @webdeploy/core migrate",
    "clean": "pnpm -r clean"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
