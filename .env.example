NODE_ENV=production
HOST=127.0.0.1
PORT=3847
PUBLIC_URL=https://deploy.example.com
MCP_PUBLIC_URL=https://deploy.example.com
MCP_SERVER_NAME=webdeploy-deploy-example-com
DATABASE_URL=postgresql://webdeploy:change-me@127.0.0.1:5432/webdeploy
DATA_DIR=/var/lib/webdeploy
CONFIG_DIR=/etc/webdeploy
MASTER_KEY_FILE=/etc/webdeploy/master.key
OIDC_JWKS_FILE=/etc/webdeploy/oidc-jwks.json
SESSION_COOKIE_NAME=wd_session
SESSION_TTL_SECONDS=43200
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
TRUST_PROXY=true
LOG_LEVEL=info
MAX_UPLOAD_BYTES=104857600
PORT_RANGE_START=41000
PORT_RANGE_END=41999
RELEASE_RETENTION_DEFAULT=5
ADMIN_SOCKET=/run/webdeploy/admin.sock
NGINX_SITES_DIR=/etc/nginx/conf.d
PM2_HOME=/var/lib/webdeploy/pm2
RUNTIME_MANAGER=mise
