[Unit]
Description=WebDeploy privileged deployment worker
After=network-online.target postgresql.service nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/webdeploy/webdeploy.env
WorkingDirectory=/opt/webdeploy/current
ExecStart=/usr/bin/node /opt/webdeploy/current/apps/worker/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=false
PrivateTmp=true
# ProtectSystem=full makes /etc read-only, and per-file ReadWritePaths cannot
# help: shadow-utils (useradd/groupadd/usermod) must CREATE lock and temp
# files inside /etc (/etc/group.<pid>, /etc/group.lock, rename-on-commit), so
# every invocation fails with "cannot lock ...; try again later". The worker
# legitimately manages /etc (user database, nginx, sshd drop-in); protect
# /usr and /boot only.
ProtectSystem=true
ProtectHome=true
RestrictSUIDSGID=false
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
