{
  "name": "@webdeploy/worker",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@webdeploy/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "tsx": "4.20.3",
    "tsup": "8.5.0",
    "typescript": "5.8.3"
  }
}
