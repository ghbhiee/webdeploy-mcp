{
  "name": "@webdeploy/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate-cli.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.20.3",
    "tsup": "8.5.0",
    "typescript": "5.8.3"
  }
}
